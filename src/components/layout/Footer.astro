---
import { siteConfig } from '@/config/site';

const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="bg-brand-dark text-white" role="contentinfo">
  <div class="container-max section-padding">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div>
        <div class="mb-4 flex items-center gap-2">
          <img src={`${base}images/logo.svg`} alt="" role="presentation" class="w-7 h-7 brightness-0 invert" width="28" height="28" />
          <div class="leading-tight">
            <span class="font-heading text-xl text-white block">{siteConfig.shortName}</span>
            <span class="text-[10px] uppercase tracking-widest text-white/50">Timber Frames</span>
          </div>
        </div>
        <p class="text-white/70 text-base mb-4 max-w-xs">
          {siteConfig.tagline}
        </p>
        <p class="text-white/50 text-sm max-w-xs">
          Designing, fabricating, and installing exquisite heirloom timber structures in Pennsylvania and the Mid-Atlantic region.
        </p>
        {/* Social links */}
        <div class="flex gap-4 mt-4">
          {siteConfig.social.facebook && (
            <a href={siteConfig.social.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="text-white/60 hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4z"/></svg>
            </a>
          )}
          {siteConfig.social.instagram && (
            <a href={siteConfig.social.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="text-white/60 hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          )}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white text-sm font-semibold uppercase tracking-wider mb-4">Quick Links</h3>
        <ul class="space-y-2">
          {siteConfig.navigation.footer.quickLinks.map((item) => (
            <li>
              <a
                href={`${base}${item.href.slice(1)}`}
                class="text-white/70 text-base hover:text-white transition-colors"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white text-sm font-semibold uppercase tracking-wider mb-4">Contact</h3>
        <div class="text-white/70 text-base space-y-2">
          <p>
            <a href={`tel:${siteConfig.contact.phone.primary}`} class="hover:text-white transition-colors">
              {siteConfig.contact.phone.formatted}
            </a>
          </p>
          <p>
            <a href={`mailto:${siteConfig.contact.email}`} class="hover:text-white transition-colors">
              {siteConfig.contact.email}
            </a>
          </p>
          <address class="not-italic text-sm text-white/60 mt-3">
            {siteConfig.contact.address.full}
          </address>
        </div>
      </div>

      <!-- Hours & Wood Species -->
      <div>
        <h3 class="text-white text-sm font-semibold uppercase tracking-wider mb-4">Shop Hours</h3>
        <div class="text-white/70 text-sm space-y-3 mb-6">
          <div>
            <p class="text-white/90 font-medium">{siteConfig.contact.hours.shop.location}</p>
            <p>{siteConfig.contact.hours.shop.days}</p>
            <p>{siteConfig.contact.hours.shop.time}</p>
          </div>
          <div>
            <p class="text-white/90 font-medium">Consultations</p>
            <p>{siteConfig.contact.hours.consultations.days}</p>
            <p>{siteConfig.contact.hours.consultations.time}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="bg-black/30 py-4">
    <div class="container-max flex flex-col md:flex-row justify-between items-center gap-2">
      <p class="text-white/50 text-sm">
        &copy; {currentYear} {siteConfig.name}. All rights reserved.
      </p>
      <p class="text-white/30 text-xs">
        Website by <a href="https://beacon-local.com" target="_blank" rel="noopener" class="hover:text-white/50 transition-colors">Beacon Local</a>
      </p>
    </div>
  </div>
</footer>
