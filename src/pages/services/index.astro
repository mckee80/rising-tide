---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
---

<BaseLayout
  title="Timber Frame Services"
  description={`Rising Tide Timber Frames designs, fabricates, and installs custom timber frame homes, barns, pavilions, roof trusses, and more in ${siteConfig.contact.address.city}, PA and surrounding regions.`}
  breadcrumbs={[{ name: 'Services', url: '/services/' }]}
>
  <!-- Hero -->
  <section class="pt-36 pb-16 bg-gradient-to-br from-brand-primary/10 to-transparent">
    <div class="container-max">
      <div class="max-w-3xl">
        <span class="section-label">Services</span>
        <h1 class="text-4xl md:text-5xl mb-6">Timber Frame Design, Fabrication & Installation</h1>
        <p class="text-lg text-brand-dark-light">
          From complete custom homes to stunning accent features, we bring the art of heavy timber construction to projects of every scale. Each structure is hand-crafted with traditional joinery and built to stand for generations.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Detail -->
  <section class="section-padding">
    <div class="container-max">
      <div class="space-y-20">
        {siteConfig.services.map((service, i) => (
          <div class={`grid lg:grid-cols-2 gap-12 items-center`}>
            <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
              <h2 class="text-2xl md:text-3xl mb-4">{service.name}</h2>
              <p class="text-brand-dark-light text-lg mb-6">{service.description}</p>
              {service.href && (
                <a href={service.href} class="btn btn-primary">
                  Learn More
                </a>
              )}
            </div>
            <div class={`bg-surface-alt rounded-xl aspect-[4/3] flex items-center justify-center ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
              <div class="service-icon w-16 h-16">
                {service.icon === 'home' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                )}
                {service.icon === 'truss' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 20h20"/><path d="M12 4l10 16"/><path d="M12 4L2 20"/><path d="M7 12h10"/><path d="M12 4v8"/></svg>
                )}
                {service.icon === 'barn' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21V11l9-8 9 8v10"/><path d="M3 21h18"/><rect x="7" y="14" width="4" height="7"/><rect x="13" y="14" width="4" height="4"/></svg>
                )}
                {service.icon === 'pavilion' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 8h16"/><path d="M2 8l10-5 10 5"/><path d="M5 8v13"/><path d="M19 8v13"/><path d="M5 21h14"/></svg>
                )}
                {service.icon === 'pool' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 12h20"/><path d="M2 8h4l2-4h8l2 4h4"/><path d="M6 12v6"/><path d="M18 12v6"/><path d="M2 18c2 2 4 2 6 0s4-2 6 0 4 2 6 0"/></svg>
                )}
                {service.icon === 'entry' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21V8l4-4h10l4 4v13"/><rect x="8" y="11" width="8" height="10"/><path d="M12 11v10"/></svg>
                )}
                {service.icon === 'design' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                )}
                {service.icon === 'restore' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.5 2v6h-6"/><path d="M21.34 15.57a10 10 0 1 1-.57-8.38L21.5 8"/></svg>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Overview -->
  <section class="section-padding bg-surface-alt">
    <div class="container-max">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <span class="section-label">Our Process</span>
        <h2 class="section-title">How We Work</h2>
        <p class="text-brand-dark-light">
          Every project follows our proven four-step process from initial vision to the excitement of frame raising day.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {siteConfig.process.map((step) => (
          <div class="bg-white rounded-xl p-6 shadow-sm text-center border border-surface-alt">
            <div class="w-12 h-12 bg-brand-primary text-white rounded-full flex items-center justify-center mx-auto mb-4 font-heading text-xl font-bold">
              {step.step}
            </div>
            <h3 class="text-lg mb-2">{step.title}</h3>
            <p class="text-brand-dark-light text-sm">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Wood Species -->
  <section class="section-padding">
    <div class="container-max">
      <div class="max-w-3xl mx-auto text-center">
        <span class="section-label">Materials</span>
        <h2 class="section-title">Premium Wood Species</h2>
        <p class="text-brand-dark-light mb-8">
          We work with a diverse range of premium wood species, each selected for its unique characteristics in strength, grain pattern, and beauty. We help you choose the ideal wood for your project.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          {siteConfig.woodSpecies.map((species) => (
            <span class="wood-tag">{species}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding bg-surface-alt">
    <div class="container-max">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <span class="section-label">Common Questions</span>
        <h2 class="section-title">Frequently Asked Questions</h2>
      </div>
      <div class="max-w-3xl mx-auto">
        {siteConfig.faq.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-gradient-to-br from-brand-accent to-brand-accent-dark">
    <div class="container-max">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl text-white mb-4">Ready to Start Your Timber Frame Project?</h2>
        <p class="text-white/85 text-lg mb-8">
          Tell us about your vision. We'll discuss your ideas, answer your questions, and help you take the first step toward your heirloom timber structure.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact/" class="btn btn-primary bg-white text-brand-accent hover:bg-gray-100 border-white btn-lg">
            Get a Free Consultation
          </a>
          <a href={`tel:${siteConfig.contact.phone.primary}`} class="btn btn-outline border-white text-white hover:bg-white/10 btn-lg">
            Call {siteConfig.contact.phone.formatted}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
