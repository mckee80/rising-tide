---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  mainEntity: {
    '@type': 'HomeAndConstructionBusiness',
    name: siteConfig.name,
    description: siteConfig.description,
    url: `${siteConfig.url}/about/`,
    knowsAbout: [
      'Timber Frame Construction',
      'Heavy Timber Construction',
      'Hand-Cut Joinery',
      'Post and Beam Construction',
      'Traditional Carpentry',
    ],
  },
};
---

<BaseLayout
  title="About Rising Tide Timber Frames"
  description="Learn about Rising Tide Timber Frames — dedicated to the art of heavy timber construction, marrying traditional hand-cut joinery with modern tools to create heirloom structures in Pennsylvania."
  jsonLd={pageSchema}
  breadcrumbs={[{ name: 'About', url: '/about/' }]}
>
  <!-- Hero -->
  <section class="pt-36 pb-16 bg-gradient-to-br from-brand-primary/10 to-transparent">
    <div class="container-max">
      <div class="max-w-3xl">
        <span class="section-label">About Us</span>
        <h1 class="text-4xl md:text-5xl mb-6">The Art of Heavy Timber Construction</h1>
        <p class="text-lg text-brand-dark-light">
          At Rising Tide Timber Frames, we are dedicated to designing, fabricating, and installing exquisite heirloom timber structures that stand the test of time.
        </p>
      </div>
    </div>
  </section>

  <!-- Our Story -->
  <section class="section-padding">
    <div class="container-max">
      <div class="grid lg:grid-cols-5 gap-12 items-start">
        <!-- Photo Column -->
        <div class="lg:col-span-2">
          <div class="w-full aspect-[3/4] rounded-xl shadow-xl bg-surface-alt flex items-center justify-center mb-6">
            <div class="text-center p-6">
              <svg class="w-12 h-12 text-brand-primary/30 mx-auto mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
              <p class="text-brand-dark-light text-sm">Workshop & craftsmanship photo</p>
            </div>
          </div>
          <div class="bg-surface-alt rounded-xl p-6">
            <h3 class="font-heading text-lg font-semibold text-brand-dark mb-4">What We Specialize In</h3>
            <div class="space-y-3">
              <div>
                <strong class="text-brand-dark">Heavy Timber Construction</strong>
                <p class="text-sm text-brand-dark-light">Traditional craft meets modern precision</p>
              </div>
              <div>
                <strong class="text-brand-dark">Hand-Cut Joinery</strong>
                <p class="text-sm text-brand-dark-light">Mortise-and-tenon joints secured with wooden pegs</p>
              </div>
              <div>
                <strong class="text-brand-dark">Custom Design</strong>
                <p class="text-sm text-brand-dark-light">From concept to construction-ready plans</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Story Column -->
        <div class="lg:col-span-3">
          <h2 class="text-2xl md:text-3xl font-heading font-semibold text-brand-dark mb-6">Our Story</h2>

          <p class="text-brand-dark-light mb-6">
            Rising Tide Timber Frames was born from a deep reverence for the ancient art of timber framing — a building tradition that has produced some of the most enduring and beautiful structures in human history. From medieval cathedrals to colonial barns, timber frames have sheltered humanity for millennia.
          </p>

          <p class="text-brand-dark-light mb-6">
            We specialize in the art of heavy timber construction, marrying traditional methods with modern tools. Our craftsmen blend centuries-old carpentry techniques with contemporary precision to meticulously hand-cut every component of each structure, with hand-cut joinery ensuring each piece of the timber frame fits together seamlessly.
          </p>

          <p class="text-brand-dark-light mb-6">
            Based in West Reading, Pennsylvania, we work with clients throughout the Mid-Atlantic region and beyond, transforming visions into custom timber structures. Whether you arrive with detailed architectural designs or start with a conceptual idea, we collaborate closely to bring your timber frame dream to life.
          </p>

          <div class="philosophy-box mb-8">
            <h3>Our Mission</h3>
            <p>To preserve and advance the art of timber framing by creating structures of extraordinary beauty and lasting integrity — heirloom pieces that honor the craft and serve families for generations to come.</p>
          </div>

          <h2 class="text-2xl md:text-3xl font-heading font-semibold text-brand-dark mb-6">What Makes Us Different</h2>

          <p class="text-brand-dark-light mb-8">
            While many timber frame companies rely primarily on CNC machines and mass production, we believe in the irreplaceable value of hand craftsmanship. Every joint is hand-cut, every timber is individually selected, and every frame is a unique work of art. We don't just build structures — we create heirlooms.
          </p>

          <!-- Highlights -->
          <div class="grid sm:grid-cols-3 gap-6">
            <div class="text-center p-6 bg-surface-alt rounded-xl">
              <div class="w-12 h-12 bg-brand-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
              </div>
              <strong class="text-brand-dark block mb-1">Hand-Cut Joinery</strong>
              <p class="text-sm text-brand-dark-light">Every joint crafted by hand with precision</p>
            </div>
            <div class="text-center p-6 bg-surface-alt rounded-xl">
              <div class="w-12 h-12 bg-brand-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <strong class="text-brand-dark block mb-1">Premium Materials</strong>
              <p class="text-sm text-brand-dark-light">Douglas Fir, White Oak, reclaimed wood & more</p>
            </div>
            <div class="text-center p-6 bg-surface-alt rounded-xl">
              <div class="w-12 h-12 bg-brand-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </div>
              <strong class="text-brand-dark block mb-1">Built with Passion</strong>
              <p class="text-sm text-brand-dark-light">Every structure is a labor of love</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-gradient-to-br from-brand-accent to-brand-accent-dark">
    <div class="container-max">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl text-white mb-4">Let's Build Something Extraordinary</h2>
        <p class="text-white/85 text-lg mb-8">
          Visit our workshop, discuss your vision, and see firsthand the quality that goes into every Rising Tide timber frame.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact/" class="btn btn-primary bg-white text-brand-accent hover:bg-gray-100 border-white btn-lg">
            Start Your Project
          </a>
          <a href={`tel:${siteConfig.contact.phone.primary}`} class="btn btn-outline border-white text-white hover:bg-white/10 btn-lg">
            Call {siteConfig.contact.phone.formatted}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
