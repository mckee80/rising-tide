---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<BaseLayout
  title="Blog | Pelvic Floor Health Articles"
  description="Articles about pelvic floor health, postpartum recovery, incontinence, pelvic pain, and more. Evidence-based information from a pelvic health specialist."
  breadcrumbs={[{ name: 'Blog', url: '/blog/' }]}
>
  <!-- Hero -->
  <section class="pt-36 pb-16 bg-gradient-to-br from-brand-primary/10 to-transparent">
    <div class="container-max">
      <div class="max-w-3xl">
        <span class="section-label">Blog</span>
        <h1 class="text-4xl md:text-5xl mb-4">Pelvic Health Articles</h1>
        <p class="text-lg text-brand-dark-light">
          Evidence-based information about pelvic floor health, recovery, and wellness.
        </p>
      </div>
    </div>
  </section>

  <!-- Posts Grid -->
  <section class="section-padding">
    <div class="container-max">
      {posts.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-brand-dark-light text-lg">No posts yet. Check back soon!</p>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <article class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow">
              {post.data.image && (
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-48 object-cover"
                  loading="lazy"
                />
              )}
              <div class="p-6">
                <div class="flex flex-wrap gap-2 mb-3">
                  {post.data.tags?.slice(0, 2).map((tag) => (
                    <span class="text-xs font-medium uppercase tracking-wider text-brand-primary bg-brand-primary/10 px-2 py-0.5 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
                <h2 class="text-xl font-heading mb-2">
                  <a href={`/blog/${post.slug}/`} class="text-brand-dark hover:text-brand-primary transition-colors">
                    {post.data.title}
                  </a>
                </h2>
                <p class="text-brand-dark-light text-sm mb-4 line-clamp-2">
                  {post.data.description}
                </p>
                <div class="flex justify-between items-center text-sm text-brand-dark-light">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </time>
                  <a href={`/blog/${post.slug}/`} class="text-brand-primary hover:text-brand-primary-dark font-medium transition-colors">
                    Read more →
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
