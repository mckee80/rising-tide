---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';

const portfolioCategories = [
  'All',
  'Timber Frame Homes',
  'Roof Trusses',
  'Barns',
  'Pavilions & Outdoor',
  'Entry Ways & Accents',
];

const portfolioItems = [
  {
    title: 'Custom Timber Frame Residence',
    category: 'Timber Frame Homes',
    description: 'Full custom timber frame home featuring Douglas Fir king post trusses and open floor plan design.',
  },
  {
    title: 'King Post Roof Truss System',
    category: 'Roof Trusses',
    description: 'Hand-cut king post trusses in White Oak, creating a stunning cathedral ceiling centerpiece.',
  },
  {
    title: 'Heritage Barn Restoration',
    category: 'Barns',
    description: 'Traditional timber frame barn built with reclaimed wood, designed for events and agricultural use.',
  },
  {
    title: 'Backyard Timber Pavilion',
    category: 'Pavilions & Outdoor',
    description: 'Open-air pavilion in Western Red Cedar, perfect for outdoor entertaining and dining.',
  },
  {
    title: 'Hammer Beam Truss Entry',
    category: 'Entry Ways & Accents',
    description: 'Dramatic hammer beam truss entry way that transforms the approach to this colonial home.',
  },
  {
    title: 'Mountain Timber Frame Cabin',
    category: 'Timber Frame Homes',
    description: 'Cozy timber frame cabin featuring exposed Douglas Fir beams and a massive stone fireplace surround.',
  },
  {
    title: 'Scissor Truss Great Room',
    category: 'Roof Trusses',
    description: 'Elegant scissor trusses spanning a 30-foot great room, creating soaring vaulted ceilings.',
  },
  {
    title: 'Pool House & Pergola',
    category: 'Pavilions & Outdoor',
    description: 'Connected pool house and pergola structure in Eastern White Cedar, blending indoor and outdoor living.',
  },
  {
    title: 'Timber Frame Porch Addition',
    category: 'Entry Ways & Accents',
    description: 'Timber frame porch with hand-carved details, adding warmth and character to a modern home.',
  },
];
---

<BaseLayout
  title="Portfolio | Our Timber Frame Projects"
  description="Browse our portfolio of custom timber frame homes, barns, pavilions, roof trusses, and accent structures. See the quality and craftsmanship of Rising Tide Timber Frames."
  breadcrumbs={[{ name: 'Portfolio', url: '/portfolio/' }]}
>
  <!-- Hero -->
  <section class="pt-36 pb-16 bg-gradient-to-br from-brand-primary/10 to-transparent">
    <div class="container-max">
      <div class="max-w-3xl mx-auto text-center">
        <span class="section-label">Our Work</span>
        <h1 class="text-4xl md:text-5xl mb-6">Portfolio</h1>
        <p class="text-lg text-brand-dark-light">
          Every Rising Tide timber frame is a unique work of art. Browse our collection of completed projects to see the craftsmanship, beauty, and attention to detail that goes into each structure.
        </p>
      </div>
    </div>
  </section>

  <!-- Category Filter -->
  <section class="py-8 bg-surface-alt border-b border-brand-primary/10 sticky top-16 md:top-[calc(4rem+2rem)] z-30">
    <div class="container-max">
      <div class="flex flex-wrap justify-center gap-3" id="portfolio-filters">
        {portfolioCategories.map((cat, i) => (
          <button
            class={`px-5 py-2 rounded-full text-sm font-medium transition-all ${i === 0 ? 'bg-brand-primary text-white' : 'bg-white text-brand-dark-light hover:bg-brand-primary/10 hover:text-brand-primary'}`}
            data-filter={cat === 'All' ? 'all' : cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Portfolio Grid -->
  <section class="section-padding">
    <div class="container-max">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="portfolio-grid">
        {portfolioItems.map((item) => (
          <div class="portfolio-item bg-white rounded-xl overflow-hidden shadow-sm border border-surface-alt hover:shadow-lg transition-shadow" data-category={item.category}>
            <div class="aspect-[4/3] bg-surface-alt flex items-center justify-center">
              <div class="text-center p-6">
                <svg class="w-12 h-12 text-brand-primary/20 mx-auto mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                <p class="text-brand-dark-light/50 text-xs">Project photo</p>
              </div>
            </div>
            <div class="p-6">
              <span class="text-xs uppercase tracking-wider text-brand-primary font-semibold">{item.category}</span>
              <h3 class="text-lg mt-1 mb-2">{item.title}</h3>
              <p class="text-brand-dark-light text-sm">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-gradient-to-br from-brand-accent to-brand-accent-dark">
    <div class="container-max">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl text-white mb-4">See Your Project Here?</h2>
        <p class="text-white/85 text-lg mb-8">
          Every project in our portfolio started with a conversation. Tell us about your vision and let's create something extraordinary together.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact/" class="btn btn-primary bg-white text-brand-accent hover:bg-gray-100 border-white btn-lg">
            Start Your Project
          </a>
          <a href={`tel:${siteConfig.contact.phone.primary}`} class="btn btn-outline border-white text-white hover:bg-white/10 btn-lg">
            Call {siteConfig.contact.phone.formatted}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll('#portfolio-filters button');
  const items = document.querySelectorAll('.portfolio-item');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => {
        b.classList.remove('bg-brand-primary', 'text-white');
        b.classList.add('bg-white', 'text-brand-dark-light');
      });
      btn.classList.remove('bg-white', 'text-brand-dark-light');
      btn.classList.add('bg-brand-primary', 'text-white');

      const filter = btn.getAttribute('data-filter');
      items.forEach(item => {
        if (filter === 'all' || item.getAttribute('data-category') === filter) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
