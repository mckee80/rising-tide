---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteConfig.url}/#organization`,
  name: siteConfig.name,
  description: siteConfig.description,
  url: siteConfig.url,
  telephone: `+1-${siteConfig.contact.phone.primary}`,
  email: siteConfig.contact.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: siteConfig.contact.address.city,
    addressRegion: siteConfig.contact.address.state,
    postalCode: siteConfig.contact.address.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteConfig.contact.geo.lat,
    longitude: siteConfig.contact.geo.lng,
  },
  areaServed: siteConfig.serviceAreas.map((area) => ({
    '@type': 'City',
    name: area,
    containedInPlace: { '@type': 'State', name: 'Pennsylvania' },
  })),
};
---

<BaseLayout
  title={`Areas Served | Timber Frame Construction in ${siteConfig.serviceAreas.slice(0, 2).join(', ')} & Beyond`}
  description={`Rising Tide Timber Frames serves ${siteConfig.serviceAreas.slice(0, 4).join(', ')} and surrounding areas. Custom timber frame homes, barns, pavilions, and structures throughout Pennsylvania and the Mid-Atlantic.`}
  jsonLd={pageSchema}
  breadcrumbs={[{ name: 'Areas Served', url: '/areas-served/' }]}
>
  <!-- Hero -->
  <section class="pt-36 pb-16 bg-gradient-to-br from-brand-primary/10 to-transparent">
    <div class="container-max">
      <div class="max-w-3xl mx-auto text-center">
        <span class="section-label">Where We Work</span>
        <h1 class="text-4xl md:text-5xl mb-6">Areas We Serve</h1>
        <p class="text-lg text-brand-dark-light mb-6">
          Based in West Reading, Pennsylvania, Rising Tide Timber Frames serves clients throughout Berks County, the surrounding region, and select projects across the Mid-Atlantic and Northeast.
        </p>
        <a href="/contact/" class="btn btn-primary btn-lg">
          Discuss Your Project Location
        </a>
      </div>
    </div>
  </section>

  <!-- How We Work -->
  <section class="section-padding">
    <div class="container-max">
      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Workshop -->
        <div class="bg-white rounded-xl p-8 shadow-sm border border-surface-alt">
          <div class="w-12 h-12 bg-brand-primary/10 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h2 class="text-xl font-heading font-semibold text-brand-dark mb-2">Our Workshop</h2>
          <p class="text-brand-primary-dark font-medium mb-4">West Reading, PA</p>
          <p class="text-brand-dark-light mb-4 text-sm">
            All timber frames are designed and fabricated in our West Reading workshop. Visit by appointment to see our craftsmen at work and discuss your project in person.
          </p>
          <div class="border-t border-gray-100 pt-4 mt-4">
            <p class="text-sm font-medium text-brand-dark mb-1">Shop Hours</p>
            <p class="text-brand-dark-light text-sm">{siteConfig.contact.hours.shop.days}</p>
            <p class="text-brand-dark-light text-sm">{siteConfig.contact.hours.shop.time}</p>
          </div>
        </div>

        <!-- Installation -->
        <div class="bg-white rounded-xl p-8 shadow-sm border border-surface-alt relative overflow-hidden">
          <div class="absolute top-4 right-4 bg-brand-primary text-white text-xs font-medium px-3 py-1 rounded-full">Primary Area</div>
          <div class="w-12 h-12 bg-brand-primary/10 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h2 class="text-xl font-heading font-semibold text-brand-dark mb-2">Pennsylvania & Mid-Atlantic</h2>
          <p class="text-brand-primary-dark font-medium mb-4">On-Site Installation</p>
          <p class="text-brand-dark-light mb-4 text-sm">
            We install (raise) timber frames throughout Pennsylvania, New Jersey, Delaware, Maryland, and the surrounding Mid-Atlantic region. Our crew travels to your site for frame raising day.
          </p>
        </div>

        <!-- Shipping -->
        <div class="bg-white rounded-xl p-8 shadow-sm border border-surface-alt">
          <div class="w-12 h-12 bg-brand-primary/10 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h2 class="text-xl font-heading font-semibold text-brand-dark mb-2">Nationwide Projects</h2>
          <p class="text-brand-primary-dark font-medium mb-4">Select Projects Beyond the Region</p>
          <p class="text-brand-dark-light mb-4 text-sm">
            For exceptional projects, we can ship timber frames and travel for installation across the Northeast and beyond. Contact us to discuss your project location and logistics.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="section-padding bg-surface-alt">
    <div class="container-max">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <span class="section-label">Local Service Areas</span>
        <h2 class="section-title">Communities We Serve</h2>
        <p class="text-brand-dark-light">
          We provide timber frame services throughout the following areas. Don't see your location? Contact us — we likely serve your area too.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 max-w-4xl mx-auto">
        {siteConfig.serviceAreas.map((area) => (
          <div class="bg-white rounded-lg px-4 py-3 text-center shadow-sm">
            <span class="text-brand-dark font-medium">{area}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-gradient-to-br from-brand-accent to-brand-accent-dark">
    <div class="container-max">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl text-white mb-4">Ready to Start Your Timber Frame Project?</h2>
        <p class="text-white/85 text-lg mb-8">Contact us to discuss your project location, timeline, and vision.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact/" class="btn btn-primary bg-white text-brand-accent hover:bg-gray-100 border-white btn-lg">Get a Free Consultation</a>
          <a href={`tel:${siteConfig.contact.phone.primary}`} class="btn btn-outline border-white text-white hover:bg-white/10 btn-lg">Call {siteConfig.contact.phone.formatted}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
